{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.claudedeck.controls",
  "Name": "Claude Deck",
  "Version": "0.1.0.0",
  "Author": "Davin",
  "Description": "Stream Deck controls and status for Claude Code sessions.",
  "Icon": "imgs/plugin/icon",
  "Category": "Claude Deck",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "Send Text",
      "UUID": "com.claudedeck.controls.send-text",
      "Icon": "imgs/actions/send-text/icon",
      "Tooltip": "Types configured text and keys into the focused window.",
      "PropertyInspectorPath": "ui/send-text.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/send-text/key",
          "TitleAlignment": "middle",
          "FontSize": 14
        }
      ]
    },
    {
      "Name": "Claude Status",
      "UUID": "com.claudedeck.controls.claude-status",
      "Icon": "imgs/actions/claude-status/icon",
      "Tooltip": "Animated character that shows whether Claude Code sessions are idle, working, or need attention.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/claude-status/key",
          "ShowTitle": false
        }
      ],
      "PropertyInspectorPath": "ui/claude-status.html"
    },
    {
      "Name": "Session Overview",
      "UUID": "com.claudedeck.controls.session-overview",
      "Icon": "imgs/actions/session-overview/icon",
      "Tooltip": "Shows the number of Claude Code sessions, running agents, and sessions waiting for input.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "imgs/actions/session-overview/encoder",
        "TriggerDescription": {
          "Rotate": "",
          "Push": "",
          "Touch": "",
          "LongTouch": ""
        }
      },
      "States": [
        {
          "Image": "imgs/actions/session-overview/key"
        }
      ]
    },
    {
      "Name": "Model Picker",
      "UUID": "com.claudedeck.controls.model-picker",
      "Icon": "imgs/actions/model-picker/icon",
      "Tooltip": "Turn to choose a model, press to send /model to the focused window.",
      "PropertyInspectorPath": "ui/model-picker.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "imgs/actions/model-picker/encoder",
        "TriggerDescription": {
          "Rotate": "Choose model",
          "Push": "Send /model",
          "Touch": "Send /model",
          "LongTouch": ""
        }
      },
      "States": [
        {
          "Image": "imgs/actions/model-picker/key"
        }
      ]
    },
    {
      "Name": "Usage",
      "UUID": "com.claudedeck.controls.usage",
      "Icon": "imgs/actions/usage/icon",
      "Tooltip": "Shows plan usage and time until reset as two bars, chosen from the 5-hour, weekly, and Sonnet weekly windows.",
      "PropertyInspectorPath": "ui/usage.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "UserTitleEnabled": false,
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "imgs/actions/usage/encoder",
        "TriggerDescription": {
          "Rotate": "",
          "Push": "Refresh",
          "Touch": "Refresh",
          "LongTouch": ""
        }
      },
      "States": [
        {
          "Image": "imgs/actions/usage/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Saved Prompts",
      "UUID": "com.claudedeck.controls.saved-prompts",
      "Icon": "imgs/actions/saved-prompts/icon",
      "Tooltip": "Turn to choose a saved prompt, press to type it into the focused window.",
      "PropertyInspectorPath": "ui/saved-prompts.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/canvas.json",
        "Icon": "imgs/actions/saved-prompts/encoder",
        "TriggerDescription": {
          "Rotate": "Choose prompt",
          "Push": "Send prompt",
          "Touch": "Send prompt",
          "LongTouch": ""
        }
      },
      "States": [
        {
          "Image": "imgs/actions/saved-prompts/key"
        }
      ]
    },
    {
      "Name": "Connection",
      "UUID": "com.claudedeck.controls.connection",
      "Icon": "imgs/actions/connection/icon",
      "Tooltip": "Shows whether Claude Code events are arriving, the number of sessions, and whether usage can be read.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/connection/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Permission Response",
      "UUID": "com.claudedeck.controls.permission",
      "Icon": "imgs/actions/permission/icon",
      "Tooltip": "Shows a pending tool permission request and answers it: allow, allow always, or deny.",
      "PropertyInspectorPath": "ui/permission.html",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/permission/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Permission Mode",
      "UUID": "com.claudedeck.controls.permission-mode",
      "Icon": "imgs/actions/permission-mode/icon",
      "Tooltip": "Shows the current permission mode and cycles it with Shift+Tab.",
      "Controllers": [
        "Keypad"
      ],
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/actions/permission-mode/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}
