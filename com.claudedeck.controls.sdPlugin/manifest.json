{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.claudedeck.controls",
  "Name": "Claude Deck",
  "Version": "0.1.0.0",
  "Author": "Davin",
  "Description": "Stream Deck controls and status for Claude Code sessions.",
  "Icon": "imgs/plugin/icon",
  "Category": "Claude Deck",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "Name": "Send Text",
      "UUID": "com.claudedeck.controls.send-text",
      "Icon": "imgs/actions/send-text/icon",
      "Tooltip": "Types configured text and keys into the focused window.",
      "PropertyInspectorPath": "ui/send-text.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/send-text/key",
          "TitleAlignment": "middle",
          "FontSize": 14
        }
      ]
    }
  ]
}
